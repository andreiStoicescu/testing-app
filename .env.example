# --- Storage ---
# Without these, data lives in memory (fine locally, NOT reliable on Vercel:
# serverless instances don't share memory and get recycled).
# Add Upstash Redis from the Vercel Marketplace (free tier) and these are set automatically.
# Only these two are used; the other TESTING_* vars Upstash adds are ignored.
TESTING_KV_REST_API_URL=
TESTING_KV_REST_API_TOKEN=
# Also supported: KV_REST_API_URL / KV_REST_API_TOKEN or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Optional key prefix, useful to run several environments on one Redis DB
DB_PREFIX=payapp

# --- Email (Resend) ---
# API key from https://resend.com/api-keys
# Without it, emails are not sent; they are visible at /mailbox instead.
RESEND_API_KEY=
# Sender address. onboarding@resend.dev works without a domain but only delivers to your own Resend account email.
# To deliver to any address (e.g. @mailinator.com) verify a domain in Resend and use an address on it.
MAIL_FROM="PayFlow <onboarding@resend.dev>"
# Set to true to keep /mailbox available even when Resend is configured
ENABLE_OUTBOX=false

# --- App ---
# Public URL used in email links; auto-detected from request host when empty
APP_URL=
# Secret used to sign session cookies
SESSION_SECRET=change-me
# Enables POST /api/admin/reset with header x-reset-secret: <value>
RESET_SECRET=
