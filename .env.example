# --- Storage ---
# Without these, data lives in memory (fine locally, NOT reliable on Vercel:
# serverless instances don't share memory and get recycled).
# Add Upstash Redis from the Vercel Marketplace (free tier) and these are set automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names also supported: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Optional key prefix, useful to run several environments on one Redis DB
DB_PREFIX=payapp

# --- Email (SMTP) ---
# Without SMTP_HOST, emails are not sent; they are visible at /mailbox instead.
# Brevo (free 300/day): host smtp-relay.brevo.com, port 587, user = your Brevo SMTP login, pass = SMTP key
# Gmail: host smtp.gmail.com, port 465, user = your gmail, pass = an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a sender verified with your provider
MAIL_FROM="PayFlow <no-reply@example.com>"
# Set to true to keep /mailbox available even when SMTP is configured
ENABLE_OUTBOX=false

# --- App ---
# Public URL used in email links; auto-detected from request host when empty
APP_URL=
# Secret used to sign session cookies
SESSION_SECRET=change-me
# Enables POST /api/admin/reset with header x-reset-secret: <value>
RESET_SECRET=
